<Window x:Class="AppDispatcher.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App Dispatcher Settings" Width="780" Height="720" WindowStartupLocation="CenterScreen"
        Activated="Window_Activated">
    <DockPanel Margin="14">
        <GroupBox Header="Windows registration" DockPanel.Dock="Top" Padding="8">
            <StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Register" Padding="10,3" Click="Register_Click"
                            ToolTip="Makes App Dispatcher available to choose as a default app, and adds it to the Start menu. Needs no admin rights, and is safe to click again."/>
                    <Button Content="Unregister" Padding="10,3" Margin="8,0,0,0" Click="Unregister_Click"
                            ToolTip="Removes App Dispatcher from Windows and the Start menu. Your settings are kept, but any file type still using it will need a new default app."/>
                    <Button Content="Open Windows Default Apps…" Padding="10,3" Margin="8,0,0,0" Click="DefaultApps_Click"
                            ToolTip="Opens the Windows page where you choose App Dispatcher for each file type and for HTTP and HTTPS links. Windows only lets you make this choice yourself."/>
                    <Button Content="Refresh status" Padding="10,3" Margin="8,0,0,0" Click="Refresh_Click"
                            ToolTip="Checks again which file types are using App Dispatcher. Use this after changing defaults in Windows."/>
                </StackPanel>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="1. Click Register.&#10;2. Add file types and their apps below.&#10;3. Click Open Windows Default Apps and choose App Dispatcher for each file type, and for HTTP and HTTPS if you want it for links. Adding a type here isn't enough, because Windows only lets you make that choice yourself."/>
            </StackPanel>
        </GroupBox>

        <TabControl Margin="0,8,0,0">
            <TabItem Header="File types" ToolTip="Which apps the picker offers for each kind of file.">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock DockPanel.Dock="Top" Text="Extensions" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Button DockPanel.Dock="Bottom" Content="Remove extension" Padding="8,3" Margin="0,6,0,0" Click="RemoveExtension_Click"
                                ToolTip="Removes the selected file type and its list of apps. If it's still set to App Dispatcher in Windows, choose a new default app for it there."/>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Add" Width="50" Margin="6,0,0,0" Click="AddExtension_Click"
                                    ToolTip="Adds this file type. Choose apps for it on the right, then set App Dispatcher as its default in Windows."/>
                            <TextBox x:Name="ExtensionBox" VerticalContentAlignment="Center" ToolTip="A file extension to handle, for example .json"/>
                        </DockPanel>
                        <ListBox x:Name="ExtensionList" DisplayMemberPath="Display" SelectionChanged="ExtensionList_SelectionChanged"
                                 ToolTip="File types App Dispatcher can open. Select one to edit its apps and see what it still needs. &quot;default&quot; means Windows is already sending that type here."/>
                    </DockPanel>

                    <DockPanel Grid.Column="1">
                        <Border x:Name="GuideBanner" DockPanel.Dock="Top" Padding="8,6" Margin="0,0,0,8" CornerRadius="3">
                            <DockPanel>
                                <Button x:Name="GuideButton" DockPanel.Dock="Right" Content="Open Windows Default Apps…" Padding="8,2" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Click="DefaultApps_Click"
                                        ToolTip="Opens the Windows page where you choose App Dispatcher for this file type."/>
                                <TextBlock x:Name="GuideText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="Apps shown in the picker, in order" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <GroupBox DockPanel.Dock="Bottom" Header="Add a custom app" Padding="6" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Label" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox x:Name="CustomLabel" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                                         ToolTip="The name shown in the picker. {solutionName} is replaced with the file's solution name."/>
                                <TextBlock Grid.Row="1" Text="Program" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox x:Name="CustomExe" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                         ToolTip="The full path of the app's .exe file."/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Padding="8,0" Margin="6,0,0,4" Click="BrowseExe_Click"
                                        ToolTip="Find the app's .exe file."/>
                                <TextBlock Grid.Row="2" Text="Arguments" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="CustomArgs" Grid.Row="2" Grid.Column="1" Text="{}{file}"
                                         ToolTip="What to pass to the app. {file} is the file's path, {dir} its folder and {solution} its solution. A row using {solution} only appears when the file has a solution above it. {file} is added at the end if you leave it out."/>
                                <Button Grid.Row="2" Grid.Column="2" Content="Add" Padding="8,0" Margin="6,0,0,0" Click="AddCustom_Click"
                                        ToolTip="Adds this app to the selected file type."/>
                            </Grid>
                        </GroupBox>

                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Add" Width="50" Margin="6,0,0,0" Click="AddCatalog_Click"
                                    ToolTip="Adds this app and window mode to the selected file type."/>
                            <ComboBox x:Name="CatalogCombo" DisplayMemberPath="Label"
                                      ToolTip="Editors found on this PC, with each way of opening a window they support."/>
                        </DockPanel>

                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBlock Text="Windows has" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="AddHandlerButton" DockPanel.Dock="Right" Content="Add" Width="50" Margin="6,0,0,0" Click="AddHandler_Click"
                                    ToolTipService.ShowOnDisabled="True" ToolTip="Adds this app to the selected file type."/>
                            <ComboBox x:Name="HandlerCombo" DisplayMemberPath="Label" ToolTipService.ShowOnDisabled="True"
                                      ToolTip="Apps Windows already knows can open the selected file type. Each is found from what the app registered when it was installed, so you don't need to look for its .exe file."/>
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="70">
                            <Button Content="Up" Padding="0,3" Click="Up_Click" ToolTip="Moves the selected app up. The order here is the order in the picker."/>
                            <Button Content="Down" Padding="0,3" Margin="0,6,0,0" Click="Down_Click" ToolTip="Moves the selected app down. The order here is the order in the picker."/>
                            <Button Content="Remove" Padding="0,3" Margin="0,6,0,0" Click="RemoveTarget_Click" ToolTip="Removes the selected app from this file type."/>
                        </StackPanel>
                        <ListBox x:Name="TargetList" DisplayMemberPath="Label"
                                 ToolTip="The picker's rows for this file type. If only one app is available, the file opens straight away with no picker."/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Links" ToolTip="What happens when a link opens, and which browsers the picker offers.">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Links without a rule" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="DefaultLinkCombo" DisplayMemberPath="Display" SelectionChanged="DefaultLink_SelectionChanged"
                                  ToolTip="What happens to a link that no rule below matches. Show the picker to choose each time, or pick a browser to open those links straight away and use rules for the exceptions."/>
                    </DockPanel>
                    <GroupBox Header="Other browsers (Chrome, Edge and Firefox are added automatically)" DockPanel.Dock="Bottom" Padding="6" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.ColumnSpan="4" Margin="0,0,0,8">
                                <TextBlock Text="Found on this PC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="AddDetectedButton" DockPanel.Dock="Right" Content="Add" Padding="8,0" Margin="6,0,0,0" Click="AddDetected_Click"
                                        ToolTipService.ShowOnDisabled="True" ToolTip="Adds the selected browser to the picker."/>
                                <ComboBox x:Name="DetectedCombo" DisplayMemberPath="Label"
                                          ToolTipService.ShowOnDisabled="True"
                                          ToolTip="Browsers found on this PC that the picker doesn't list yet, with one entry per profile where profiles can be read."/>
                            </DockPanel>

                            <ListBox x:Name="CustomBrowserList" Grid.Row="1" Grid.RowSpan="3" DisplayMemberPath="Label" Margin="0,0,10,4"
                                     ToolTip="Browsers you've added. They appear in the picker after Chrome, Edge and Firefox."/>
                            <Button Grid.Row="4" Content="Remove" HorizontalAlignment="Left" Padding="10,0" Margin="0,0,10,0" Click="RemoveBrowser_Click"
                                    ToolTip="Removes the selected browser from the picker, along with any Always open rules that use it."/>

                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Label" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="BrowserLabel" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,0,4"
                                     ToolTip="The name shown in the picker."/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Program" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="BrowserExe" Grid.Row="2" Grid.Column="2" Margin="0,0,0,4"
                                     ToolTip="The full path of the browser's .exe file."/>
                            <Button Grid.Row="2" Grid.Column="3" Content="Browse…" Padding="8,0" Margin="6,0,0,4" Click="BrowseBrowser_Click"
                                    ToolTip="Find the browser's .exe file."/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Arguments" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="BrowserArgs" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Text="{}{url}" Margin="0,0,0,4"
                                     ToolTip="What to pass to the browser. {url} is replaced with the link, and added at the end if you leave it out. For example: --incognito {url}"/>
                            <Button Grid.Row="4" Grid.Column="3" Content="Add" Padding="8,0" Margin="6,0,0,0" Click="AddBrowser_Click"
                                    ToolTip="Adds the browser described in these boxes to the picker."/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Add rule" DockPanel.Dock="Bottom" Padding="8" Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Update selected" Padding="8,0" Margin="8,0,0,0" Click="UpdateRule_Click"
                                    ToolTip="Replaces the rule selected above with this domain and browser."/>
                            <Button DockPanel.Dock="Right" Content="Add" Width="60" Margin="8,0,0,0" Click="AddRule_Click"
                                    ToolTip="Adds a rule, so that links matching it do what you've chosen here."/>
                            <TextBox x:Name="DomainBox" Width="180" DockPanel.Dock="Left" VerticalContentAlignment="Center"
                                     ToolTip="A domain, which includes its subdomains, such as github.com. Add a path to match only part of a site, such as github.com/myorg. You can also paste a whole link."/>
                            <ComboBox x:Name="BrowserCombo" Margin="8,0,0,0" DisplayMemberPath="Display"
                                      ToolTip="Show the picker for matching links, or open them straight away in this browser and profile."/>
                        </DockPanel>
                    </GroupBox>
                    <Button DockPanel.Dock="Bottom" Content="Remove selected rule" HorizontalAlignment="Left" Padding="10,3"
                            Margin="0,8,0,0" Click="RemoveRule_Click"
                            ToolTip="Removes the selected rule, so matching links follow the setting at the top of this tab."/>
                    <GroupBox Header="Rules for specific links" Padding="4">
                        <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="RulesGrid_SelectionChanged"
                                  ToolTip="Exceptions to the setting at the top of this tab. When several rules match a link, the most specific one wins.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Domain or link" Binding="{Binding Domain}" Width="200"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Browser}" Width="110"/>
                                <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
