<Window x:Class="AppDispatcher.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App Dispatcher Settings" Width="780" Height="640" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">
        <GroupBox Header="Windows registration" DockPanel.Dock="Top" Padding="8">
            <StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Register" Padding="10,3" Click="Register_Click"/>
                    <Button Content="Unregister" Padding="10,3" Margin="8,0,0,0" Click="Unregister_Click"/>
                    <Button Content="Open Windows Default Apps…" Padding="10,3" Margin="8,0,0,0" Click="DefaultApps_Click"/>
                    <Button Content="Refresh status" Padding="10,3" Margin="8,0,0,0" Click="Refresh_Click"/>
                </StackPanel>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Gray"
                           Text="Registering makes App Dispatcher selectable. Then choose it for each file type (and HTTP/HTTPS) in Windows Default Apps; Windows doesn't let apps set this themselves."/>
            </StackPanel>
        </GroupBox>

        <TabControl Margin="0,8,0,0">
            <TabItem Header="File types">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock DockPanel.Dock="Top" Text="Extensions" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Button DockPanel.Dock="Bottom" Content="Remove extension" Padding="8,3" Margin="0,6,0,0" Click="RemoveExtension_Click"/>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Add" Width="50" Margin="6,0,0,0" Click="AddExtension_Click"/>
                            <TextBox x:Name="ExtensionBox" VerticalContentAlignment="Center" ToolTip="e.g. .json"/>
                        </DockPanel>
                        <ListBox x:Name="ExtensionList" DisplayMemberPath="Display" SelectionChanged="ExtensionList_SelectionChanged"/>
                    </DockPanel>

                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="Apps shown in the picker, in order" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <GroupBox DockPanel.Dock="Bottom" Header="Add a custom app" Padding="6" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Label" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox x:Name="CustomLabel" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Text="Program" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox x:Name="CustomExe" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Padding="8,0" Margin="6,0,0,4" Click="BrowseExe_Click"/>
                                <TextBlock Grid.Row="2" Text="Arguments" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="CustomArgs" Grid.Row="2" Grid.Column="1" Text="{}{file}"
                                         ToolTip="Placeholders: {file} {dir} {solution}. A {solution} row only appears when the file has a solution above it."/>
                                <Button Grid.Row="2" Grid.Column="2" Content="Add" Padding="8,0" Margin="6,0,0,0" Click="AddCustom_Click"/>
                            </Grid>
                        </GroupBox>

                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Add" Width="50" Margin="6,0,0,0" Click="AddCatalog_Click"/>
                            <ComboBox x:Name="CatalogCombo" DisplayMemberPath="Label"/>
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="70">
                            <Button Content="Up" Padding="0,3" Click="Up_Click"/>
                            <Button Content="Down" Padding="0,3" Margin="0,6,0,0" Click="Down_Click"/>
                            <Button Content="Remove" Padding="0,3" Margin="0,6,0,0" Click="RemoveTarget_Click"/>
                        </StackPanel>
                        <ListBox x:Name="TargetList" DisplayMemberPath="Label"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Links">
                <DockPanel Margin="8">
                    <GroupBox Header="Custom browsers (Chrome, Edge and Firefox are detected automatically)" DockPanel.Dock="Bottom" Padding="6" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="CustomBrowserList" Grid.RowSpan="3" DisplayMemberPath="Label" Margin="0,0,10,4"/>
                            <Button Grid.Row="3" Content="Remove" HorizontalAlignment="Left" Padding="10,0" Margin="0,0,10,0" Click="RemoveBrowser_Click"/>

                            <TextBlock Grid.Column="1" Text="Label" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="BrowserLabel" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Program" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="BrowserExe" Grid.Row="1" Grid.Column="2" Margin="0,0,0,4"/>
                            <Button Grid.Row="1" Grid.Column="3" Content="Browse…" Padding="8,0" Margin="6,0,0,4" Click="BrowseBrowser_Click"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Arguments" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="BrowserArgs" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="{}{url}" Margin="0,0,0,4"
                                     ToolTip="{}{url} is replaced with the link, and added at the end if left out. e.g. --incognito {url}"/>
                            <Button Grid.Row="3" Grid.Column="3" Content="Add" Padding="8,0" Margin="6,0,0,0" Click="AddBrowser_Click"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Add rule" DockPanel.Dock="Bottom" Padding="8" Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Update selected" Padding="8,0" Margin="8,0,0,0" Click="UpdateRule_Click"/>
                            <Button DockPanel.Dock="Right" Content="Add" Width="60" Margin="8,0,0,0" Click="AddRule_Click"/>
                            <TextBox x:Name="DomainBox" Width="180" DockPanel.Dock="Left" VerticalContentAlignment="Center"
                                     ToolTip="e.g. github.com (includes subdomains)"/>
                            <ComboBox x:Name="BrowserCombo" Margin="8,0,0,0" DisplayMemberPath="Display"/>
                        </DockPanel>
                    </GroupBox>
                    <Button DockPanel.Dock="Bottom" Content="Remove selected rule" HorizontalAlignment="Left" Padding="10,3"
                            Margin="0,8,0,0" Click="RemoveRule_Click"/>
                    <GroupBox Header="Always-open rules" Padding="4">
                        <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="RulesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="200"/>
                                <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="90"/>
                                <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
